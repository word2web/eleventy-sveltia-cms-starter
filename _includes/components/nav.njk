<nav>
  {% set navPages = collections.all | eleventyNavigation %}
  <ul>
    {%- for entry in navPages %}
      <li>
        <a href="{{ entry.url | url }}">
          {{ entry.title }} 
          <small style="color:red;">(nav_exclude: {{ entry.data.nav_exclude }})</small>
        </a>
      </li>
    {%- endfor %}
  </ul>
</nav>