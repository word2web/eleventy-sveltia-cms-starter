<nav>
  {% set navPages = collections.all | eleventyNavigation %}
  <ul>
    {%- for entry in navPages %}
      {# entry.nav_exclude will now correctly see the value inside the block #}
      {% if not entry.nav_exclude %}
        <li>
          <a href="{{ entry.url | url }}"{% if entry.url == page.url %} data-current="active"{% endif %}>
            {{ entry.title }}
          </a>
        </li>
      {% endif %}
    {%- endfor %}
  </ul>
</nav>